<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         1. 品牌色 / 固定色（浅色深色都不变）
         ============================================================ -->
    <!-- 品牌红。固定值，深浅色都不变：ic_launcher_foreground 用的是同一个色值，
         启动图标不能跟着系统主题变色。App 内需按主题调整的用 lcg_brand_accent。 -->
    <color name="pojie_logo">#E01720</color>
    <color name="pojie_logo_light">#A89F9F</color>
    <color name="lcg_brand_accent">@color/pojie_logo</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- ============================================================
         2. M3 语义 token —— 浅色
         关键改动：lcg_background 从 #FAFAFA 调深到 #F2EFEF。
         原来 #FAFAFA 与卡片 #FFFFFF 只差 2%，肉眼分不出，列表卡片
         之间全靠 3dp elevation 的阴影"糊"出一条分界线，就是截图里
         那种脏兮兮的渐变带。把底色压深之后，卡片可以彻底不要阴影。
         ============================================================ -->
    <color name="lcg_surface">#FFFFFF</color>
    <color name="lcg_on_surface">#1C1B1B</color>
    <color name="lcg_surface_variant">#EBE7E7</color>
    <!-- 次要文字从 #696969 调到 #5A5555：12sp 小字在白底上对比度需要更高 -->
    <color name="lcg_on_surface_variant">#5A5555</color>
    <color name="lcg_background">#F2EFEF</color>

    <!-- 容器层级（M3 surfaceContainer 家族），给 tab 栏 / 输入框 / chip 用 -->
    <color name="lcg_surface_container_low">#F7F4F4</color>
    <color name="lcg_surface_container">#F0ECEC</color>
    <color name="lcg_surface_container_high">#EAE6E6</color>

    <color name="lcg_primary_container">#E6E6E6</color>
    <color name="lcg_on_primary_container">#2A2A2A</color>
    <color name="lcg_secondary_container">#FFE4E6</color>

    <color name="lcg_tertiary">#6E5B40</color>
    <color name="lcg_on_tertiary">#FFFFFF</color>
    <color name="lcg_tertiary_container">#F8DEBE</color>
    <color name="lcg_on_tertiary_container">#261904</color>

    <color name="lcg_error">#BA1A1A</color>
    <color name="lcg_on_error">#FFFFFF</color>
    <color name="lcg_error_container">#FFDAD6</color>
    <color name="lcg_on_error_container">#410002</color>

    <color name="lcg_outline">#7B7670</color>
    <color name="lcg_outline_variant">#DED8D8</color>

    <color name="lcg_switch_track_on">#80E01720</color>

    <!-- ============================================================
         3. 历史 token —— 保留名字，值对齐到上面的语义 token。
            布局里还有 90+ 处直接引用这些名字，逐个改成 ?attr 风险大，
            这里先让它们在 values-night 里能整体翻转。
            新写的布局请直接用 ?attr/colorSurface 一类，别再用这些。
         ============================================================ -->
    <color name="colorPrimary">@color/black_effective</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">@color/pojie_logo</color>

    <color name="black">#000000</color>
    <color name="black_effective">#2A2A2A</color>
    <color name="light_gray">#DBDBDB</color>
    <color name="slight_light_gray">#ECECEC</color>
    <color name="slight_light_light_gray">#F7F6F6</color>
    <color name="gray">#6E6969</color>
    <color name="semi_gray">#8A8585</color>
    <color name="dark_gray">#4A4646</color>
    <color name="bg_color">#F2EFEF</color>
    <color name="shadow">#D0D8DC</color>
    <color name="translucent_white">#88FFFFFF</color>
    <color name="translucent_gray">#4DECECEC</color>
    <color name="light_grey_background">#ECECEC</color>

    <color name="cancel">#DD4D0A</color>
    <color name="red_dark">#F06423</color>
    <color name="red_dark2">#D85A1B</color>
    <color name="cyan_light">#C9EBEE</color>
    <color name="cyan">#B5E3E7</color>
    <color name="cyan_dark">#70BDC6</color>
    <color name="navy_blue">#214258</color>
    <color name="navy_blue_dark">#1C3A4E</color>
    <color name="light_green">#78DC96</color>
    <color name="light_blue">#55C8F0</color>
    <color name="blue_black_dark">#13171D</color>
    <color name="blue_black_light">#516179</color>
    <color name="blue_grey_light">#A5B4C8</color>
    <color name="orange">#FFA500</color>
    <color name="yellow">#FFF44F</color>

    <color name="statusBarColorRecommend">#000000</color>
    <color name="statusBarColorMessageTab">#FFFFFF</color>
    <color name="statusBarColorWhite">#FFFFFF</color>
    <color name="statusBarColorDefault">@color/colorPrimary</color>

</resources>
